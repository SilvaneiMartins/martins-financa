{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Martins Finança",
  "mainBinaryName": "martins-financa",
  "version": "0.1.0",
  "identifier": "br.com.agenciamartins.financa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Martins Finança",
        "width": 1200,
        "height": 680,
        "minWidth": 960,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Gestão financeira pessoal e familiar gratuita",
    "longDescription": "Martins Finança é um aplicativo gratuito e open source da Agência Martins para controlar receitas, despesas, cartões, financiamentos, planejamento familiar, viagens e metas de longo prazo.",
    "copyright": "© 2026 Agência Martins — MIT",
    "publisher": "Agência Martins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
