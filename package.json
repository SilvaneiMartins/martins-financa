{
  "name": "martins-financa",
  "private": true,
  "version": "0.1.0",
  "description": "Martins Finança — monorepo (app desktop + site)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "desktop:dev": "pnpm --filter @martins/desktop app:dev",
    "desktop:build": "pnpm --filter @martins/desktop app:build",
    "web:dev": "pnpm --filter @martins/web dev",
    "web:build": "pnpm --filter @martins/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build"
  }
}
